{
  "name": "nocturne-studio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kelvin e Silva Marques",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "start": "node --import tsx server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "analyze": "python scripts/analyze.py",
    "project": "node --import tsx scripts/prepare.ts",
    "render": "node --import tsx scripts/render.ts",
    "verify": "node --import tsx scripts/verify.ts",
    "remotion:studio": "remotion studio src/remotion/index.tsx",
    "fonts": "python3 scripts/fonts.py",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "deploy": "node scripts/deploy-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.62.1",
    "franc-min": "6.2.0",
    "mediabunny": "^1.62.1",
    "onnxruntime-web": "1.22.0",
    "opentype.js": "^2.0.0",
    "puppeteer-core": "^25.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.374",
    "sharp": "^0.34.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.374",
    "@types/node": "24.7.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.186.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
